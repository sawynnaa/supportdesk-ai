{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "../../dist/server",
    "rootDir": "../../",
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "../worker/src/**/*.ts",
    "../../packages/**/*.ts",
    "../../scripts/**/*.ts",
    "../../evals/scripts/**/*.ts"
  ]
}
