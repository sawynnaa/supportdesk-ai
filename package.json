{
  "name": "supportdesk-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch apps/api/src/main.ts\" \"vite --host 127.0.0.1\"",
    "start": "tsx apps/api/src/main.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "build": "vue-tsc --noEmit && vite build && tsc -p apps/api/tsconfig.json",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p apps/api/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "tsx evals/scripts/evaluate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "perf": "tsx scripts/performance.ts",
    "format": "prettier --write apps packages tests scripts evals/scripts *.ts *.js *.json infra .github"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "element-plus": "2.10.7",
    "express": "5.1.0",
    "lucide-vue-next": "0.468.0",
    "marked": "15.0.12",
    "dompurify": "3.2.6",
    "pg": "8.16.3",
    "pinia": "3.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "vue": "3.5.18",
    "vue-router": "4.5.1",
    "zod": "3.25.76",
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@playwright/test": "1.55.0",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "22.17.1",
    "@types/pg": "8.15.5",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "concurrently": "9.2.0",
    "eslint": "9.33.0",
    "eslint-plugin-vue": "10.4.0",
    "typescript-eslint": "8.39.1",
    "jsdom": "26.1.0",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vite": "7.1.2",
    "vitest": "3.2.4",
    "vue-tsc": "3.0.5",
    "prisma": "6.19.0",
    "prettier": "3.6.2"
  }
}
